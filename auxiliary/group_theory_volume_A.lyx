\end_inset
 אינה תלויה בבחירת הנציגים.
\end_layout

\end_deeper
\begin_layout Proof
נוכיח את המעגל בשלבים. השוויון \begin_inset Formula $gH=Hg$
\end_inset
 שקול, לאחר כפל מימין ב־\begin_inset Formula $g^{-1}$
\end_inset
, לשוויון \begin_inset Formula $gHg^{-1}=H$
\end_inset
. ברור ששוויון גורר הכלה. להפך, אם \begin_inset Formula $gHg^{-1}\subseteq H$
\end_inset
 לכל \begin_inset Formula $g$
\end_inset
, ניישם זאת ב־\begin_inset Formula $g^{-1}$
\end_inset
 ונקבל \begin_inset Formula $g^{-1}Hg\subseteq H$
\end_inset
; הצמדה ב־\begin_inset Formula $g$
\end_inset
 נותנת \begin_inset Formula $H\subseteq gHg^{-1}$
\end_inset
, ולכן יש שוויון. נניח כעת \begin_inset Formula $gH=Hg$
\end_inset
 לכל \begin_inset Formula $g$
\end_inset
. אז לכל \begin_inset Formula $g,k\in G$
\end_inset
, \begin_inset Formula 
\[
gHkH=gkHH=gkH,
\]

\end_inset
 כאשר במעבר הראשון העברנו את \begin_inset Formula $H$
\end_inset
 דרך \begin_inset Formula $k$
\end_inset
. לכן מכפלת שתי מחלקות שמאליות היא מחלקה שמאלית, ואף שווה ל־\begin_inset Formula $gkH$
\end_inset
. בפרט, אם \begin_inset Formula $gH=g'H$
\end_inset
 ו־\begin_inset Formula $kH=k'H$
\end_inset
, אז \begin_inset Formula 
\[
gkH=(gH)(kH)=(g'H)(k'H)=g'k'H,
\]

\end_inset
 ולכן הנוסחה אינה תלויה בבחירת הנציגים. נותר להראות שהדרישה האחרונה גוררת נורמליות. יהיו \begin_inset Formula $g\in G$
\end_inset
 ו־\begin_inset Formula $h\in H$
\end_inset
. למחלקה \begin_inset Formula $H$
\end_inset
 יש שני נציגים, \begin_inset Formula $e$
\end_inset
 ו־\begin_inset Formula $h$
\end_inset
. מן המוגדרות היטב, בהכפלת \begin_inset Formula $H$
\end_inset
 במחלקה \begin_inset Formula $gH$
\end_inset
, נקבל \begin_inset Formula 
\[
(eH)(gH)=(hH)(gH),
\]

\end_inset
 כלומר \begin_inset Formula $gH=hgH$
\end_inset
. מכאן \begin_inset Formula $hg\in gH$
\end_inset
, ולכן קיים \begin_inset Formula $h'\in H$
\end_inset
 כך ש־\begin_inset Formula $hg=gh'$
\end_inset
. לכן \begin_inset Formula $g^{-1}hg=h'\in H$
\end_inset
. קיבלנו \begin_inset Formula $g^{-1}Hg\subseteq H$
\end_inset
 לכל \begin_inset Formula $g$
\end_inset
; החלפת \begin_inset Formula $g$
\end_inset
 ב־\begin_inset Formula $g^{-1}$
\end_inset
 נותנת את התנאי השקול \begin_inset Formula $gHg^{-1}\subseteq H$
\end_inset
. בכך הושלמו כל השקילויות.
\end_layout

\begin_layout Definition
תת־חבורה \begin_inset Formula $N\le G$
\end_inset
 נקראת \emph on
נורמלית\emph default
 אם \begin_inset Formula $gNg^{-1}=N$
\end_inset
 לכל \begin_inset Formula $g\in G$
\end_inset
. נסמן \begin_inset Formula $N\trianglelefteq G$
\end_inset
.
\end_layout

\begin_layout Standard
כל תת־חבורה של חבורה אבלית היא נורמלית. גם כל תת־חבורה מאינדקס \begin_inset Formula $2$
\end_inset
 נורמלית. מצד אחר, \begin_inset Formula $\langle(12)\rangle$
\end_inset
 אינה נורמלית ב־\begin_inset Formula $S_3$
\end_inset
, שכן למשל \begin_inset Formula $(123)(12)(123)^{-1}=(23)$
\end_inset
.
\end_layout

\begin_layout Definition
אם \begin_inset Formula $N\trianglelefteq G$
\end_inset
, קבוצת המחלקות \begin_inset Formula $G/N$
\end_inset
 נעשית חבורה על־ידי \begin_inset Formula 
\[
(gN)(hN)=ghN.
\]

\end_inset
 חבורה זו נקראת \emph on
חבורת המנה\emph default
 של \begin_inset Formula $G$
\end_inset
 ב־\begin_inset Formula $N$
\end_inset
.
\end_layout

\begin_layout Standard
איבר היחידה במנה הוא \begin_inset Formula $N=eN$
\end_inset
, וההופכי של \begin_inset Formula $gN$
\end_inset
 הוא \begin_inset Formula $g^{-1}N$
\end_inset
. הרעיון של מנה הוא "להכריז" שכל איברי \begin_inset Formula $N$
\end_inset
 שווים ליחידה, ובכך לזהות איברים שנבדלים בכפל באיבר מ־\begin_inset Formula $N$
\end_inset
.
\end_layout

\begin_layout Examples

\end_layout

\begin_deeper
\begin_layout Enumerate
\begin_inset Formula $\mathbb Z/n\mathbb Z$
\end_inset
 היא חבורת המנה של \begin_inset Formula $\mathbb Z$
\end_inset
 בתת־החבורה \begin_inset Formula $n\mathbb Z$
\end_inset
.
\end_layout

\begin_layout Enumerate
אם \begin_inset Formula $G=C_4=\langle a\rangle$
\end_inset
 ו־\begin_inset Formula $N=\langle a^2\rangle$
\end_inset
, אז \begin_inset Formula $G/N\cong C_2$
\end_inset
.
\end_layout

\begin_layout Enumerate
\begin_inset Formula $SL_n(F)\trianglelefteq GL_n(F)$
\end_inset
, ובהמשך נראה ש־\begin_inset Formula $GL_n(F)/SL_n(F)\cong F^\times$
\end_inset
.
\end_layout

\begin_layout Enumerate
אם \begin_inset Formula $G,H$
\end_inset
 חבורות, אז \begin_inset Formula $G\times\{e\}\trianglelefteq G\times H$
\end_inset
 ו־\begin_inset Formula $(G\times H)/(G\times\{e\})\cong H$
\end_inset
.
\end_layout

\end_deeper
\begin_layout Subsection
מפת המנה וקריטריונים לנורמליות
\end_layout

\begin_layout Standard
לחבורת מנה נלווית תמיד מפה טבעית.
\end_layout

\begin_layout Definition
אם \begin_inset Formula $N\trianglelefteq G$
\end_inset
, \emph on
מפת המנה\emph default
 היא \begin_inset Formula 
\[
\pi:G\longrightarrow G/N,\qquad \pi(g)=gN.
\]

\end_inset

\end_layout

\begin_layout Claim
מפת המנה היא הומומורפיזם על, ו־\begin_inset Formula $\ker\pi=N$
\end_inset
.
\end_layout

\begin_layout Proof
מתקיים \begin_inset Formula $\pi(gh)=ghN=(gN)(hN)=\pi(g)\pi(h)$
\end_inset
, וכל מחלקה היא \begin_inset Formula $\pi(g)$
\end_inset
 עבור נציג כלשהו. לבסוף, \begin_inset Formula $\pi(g)=N$
\end_inset
 אם ורק אם \begin_inset Formula $g\in N$
\end_inset
.
\end_layout

\begin_layout Standard
מכאן מתקבלת תובנה חשובה: \emph on
תת־החבורות הנורמליות הן בדיוק הגרעינים של הומומורפיזמים\emph default
. כל גרעין נורמלי, כפי שנוכיח מיד; ובכיוון ההפוך, \begin_inset Formula $N\trianglelefteq G$
\end_inset
 היא גרעין מפת המנה \begin_inset Formula $G\to G/N$
\end_inset
.
\end_layout

\begin_layout Standard
נורמליות אינה טרנזיטיבית. למשל \begin_inset Formula $\langle(12)(34)\rangle\trianglelefteq V_4$
\end_inset
 מפני ש־\begin_inset Formula $V_4$
\end_inset
 אבלית, ו־\begin_inset Formula $V_4\trianglelefteq A_4$
\end_inset
, אך \begin_inset Formula $\langle(12)(34)\rangle$
\end_inset
 אינה נורמלית ב־\begin_inset Formula $A_4$
\end_inset
: הצמדה ב־\begin_inset Formula $(123)$
\end_inset
 שולחת את היוצר שלה לכפול־טרנספוזיציה אחרת.
\end_layout

\begin_layout Question
הוכיחו: \begin_inset Formula $Z(G)\trianglelefteq G$
\end_inset
; ואם \begin_inset Formula $N\trianglelefteq G$
\end_inset
 ו־\begin_inset Formula $H\le G$
\end_inset
, אז \begin_inset Formula $N\cap H\trianglelefteq H$
\end_inset
.
\end_layout

\begin_layout Solution
אם \begin_inset Formula $z\in Z(G)$
\end_inset
 ו־\begin_inset Formula $g\in G$
\end_inset
, אז \begin_inset Formula $gzg^{-1}=z$
\end_inset
, ולכן המרכז נשמר בהצמדה. אם \begin_inset Formula $x\in N\cap H$
\end_inset
 ו־\begin_inset Formula $h\in H$
\end_inset
, אז \begin_inset Formula $hxh^{-1}\in N$
\end_inset
 מנורמליות \begin_inset Formula $N$
\end_inset
 וגם \begin_inset Formula $hxh^{-1}\in H$
\end_inset
 משום \begin_inset Formula $H$
\end_inset
 תת־חבורה; לכן הוא בחיתוך.
\end_layout

\begin_layout Question
יהי \begin_inset Formula $N\trianglelefteq G$
\end_inset
.
\end_layout

\begin_deeper
\begin_layout Enumerate
הוכיחו ש־\begin_inset Formula $G/N$
\end_inset
 אבלית אם ורק אם לכל \begin_inset Formula $a,b\in G$
\end_inset
 מתקיים \begin_inset Formula $aba^{-1}b^{-1}\in N$
\end_inset
.
\end_layout

\begin_layout Enumerate
חשבו את \begin_inset Formula $(\mathbb Z/12\mathbb Z)/\langle\bar4\rangle$
\end_inset
 עד כדי איזומורפיזם.
\end_layout

\begin_layout Enumerate
מצאו את כל תת־החבורות הנורמליות של \begin_inset Formula $S_3$
\end_inset
.
\end_layout

\end_deeper
\begin_layout Solution
\begin_inset Formula 
\[
(aN)(bN)(aN)^{-1}(bN)^{-1}=(aba^{-1}b^{-1})N.
\]

\end_inset
 לכן \begin_inset Formula $G/N$
\end_inset
 אבלית אם ורק אם \begin_inset Formula $aba^{-1}b^{-1}\in N$
\end_inset
 לכל \begin_inset Formula $a,b\in G$
\end_inset
.
\end_layout

\begin_deeper
\begin_layout Enumerate
במנה מתקיים \begin_inset Formula $(aN)(bN)=(bN)(aN)$
\end_inset
 אם ורק אם הקומוטטור של שתי המחלקות הוא היחידה. אבל
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\langle\bar4\rangle$
\end_inset
 היא מסדר \begin_inset Formula $3$
\end_inset
, ולכן המנה מסדר \begin_inset Formula $4$
\end_inset
. החבורה \begin_inset Formula $\mathbb Z/12\mathbb Z$
\end_inset
 ציקלית, ומנה של חבורה ציקלית ציקלית: המחלקה של \begin_inset Formula $\bar1$
\end_inset
 יוצרת. לכן המנה איזומורפית ל־\begin_inset Formula $C_4$
\end_inset
.
\end_layout

\begin_layout Enumerate
תת־חבורה נורמלית היא איחוד של מחלקות צמידות ומכילה את \begin_inset Formula $e$
\end_inset
. מחלקות הצמידות של \begin_inset Formula $S_3$
\end_inset
 הן בגדלים \begin_inset Formula $1,3,2$
\end_inset
. האפשרויות שנותנות תת־חבורה הן \begin_inset Formula $\{e\}$
\end_inset
, \begin_inset Formula $A_3=\{e,(123),(132)\}$
\end_inset
, ו־\begin_inset Formula $S_3$
\end_inset
. תת־חבורה מסדר \begin_inset Formula $2$
\end_inset
 אינה נורמלית כי שלוש תת־החבורות מסדר זה צמודות זו לזו.
\end_layout

\end_deeper
\begin_layout Section
הומומורפיזמים: גרעין ותמונה
\end_layout

\begin_layout Definition
להומומורפיזם \begin_inset Formula $f:G\to H$
\end_inset
 נגדיר את \emph on
התמונה\emph default
 \begin_inset Formula 
\[
\operatorname{Im}f=f(G),
\]

\end_inset
 ואת \emph on
הגרעין\emph default
 \begin_inset Formula 
\[
\ker f=\{g\in G:f(g)=e_H\}.
\]

\end_inset

\end_layout

\begin_layout Theorem
\begin_inset Formula $\operatorname{Im}f\le H$
\end_inset
 ו־\begin_inset Formula $\ker f\trianglelefteq G$
\end_inset
.
\end_layout

\begin_layout Proof
אם \begin_inset Formula $x=f(a)$
\end_inset
 ו־\begin_inset Formula $y=f(b)$
\end_inset
 בתמונה, אז \begin_inset Formula $xy^{-1}=f(ab^{-1})$
\end_inset
 בתמונה, ולכן זו תת־חבורה. אם \begin_inset Formula $k\in\ker f$
\end_inset
 ו־\begin_inset Formula $g\in G$
\end_inset
, אז \begin_inset Formula $f(gkg^{-1})=f(g)e f(g)^{-1}=e$
\end_inset
, ולכן \begin_inset Formula $gkg^{-1}\in\ker f$
\end_inset
. מכאן הגרעין נורמלי.
\end_layout

\begin_layout Lemma
הומומורפיזם \begin_inset Formula $f:G\to H$
\end_inset
 הוא חד־חד־ערכי אם ורק אם \begin_inset Formula $\ker f=\{e\}$
\end_inset
.
\end_layout

\begin_layout Proof
אם \begin_inset Formula $f$
\end_inset
 חד־חד־ערכי ו־\begin_inset Formula $f(g)=e=f(e)$
\end_inset
, אז \begin_inset Formula $g=e$
\end_inset
. להפך, אם הגרעין טריוויאלי ו־\begin_inset Formula $f(a)=f(b)$
\end_inset
, אז \begin_inset Formula $f(a^{-1}b)=e$
\end_inset
, ולכן \begin_inset Formula $a^{-1}b=e$
\end_inset
 ומכאן \begin_inset Formula $a=b$
\end_inset
.
\end_layout

\begin_layout Standard
הגרעין מודד בדיוק כמה מידע ההומומורפיזם מאבד. שני איברים נשלחים לאותה תמונה אם ורק אם הם באותה מחלקה של הגרעין: \begin_inset Formula 
\[
f(a)=f(b)\Longleftrightarrow a^{-1}b\in\ker f\Longleftrightarrow a\ker f=b\ker f.
\]

\end_inset
 זוהי התצפית שמובילה למשפט האיזומורפיזם הראשון.
\end_layout

\begin_layout Theorem
\begin_inset Argument 1
status open

\begin_layout Plain Layout
משפט האיזומורפיזם הראשון
\end_layout

\end_inset
אם \begin_inset Formula $f:G\to H$
\end_inset
 הומומורפיזם, אז \begin_inset Formula 
\[
G/\ker f\cong\operatorname{Im}f.
\]

\end_inset
 האיזומורפיזם נתון על־ידי \begin_inset Formula 
\[
g\ker f\longmapsto f(g).
\]

\end_inset

\end_layout

\begin_layout Proof
נגדיר \begin_inset Formula $\bar f(g\ker f)=f(g)$
\end_inset
. אם \begin_inset Formula $g\ker f=h\ker f$
\end_inset
, אז \begin_inset Formula $h^{-1}g\in\ker f$
\end_inset
, ולכן \begin_inset Formula $f(g)=f(h)$
\end_inset
; מכאן ההגדרה אינה תלויה בנציג. המפה שומרת מכפלה וברור שהיא על \begin_inset Formula $\operatorname{Im}f$
\end_inset
. אם \begin_inset Formula $\bar f(g\ker f)=e$
\end_inset
, אז \begin_inset Formula $g\in\ker f$
\end_inset
, ולכן \begin_inset Formula $g\ker f=\ker f$
\end_inset
, איבר היחידה במנה. הגרעין של \begin_inset Formula $\bar f$
\end_inset
 טריוויאלי, ולכן היא חד־חד־ערכית.
\end_layout

\begin_layout Standard
המשפט אומר שכל הומומורפיזם מתפרק לשני שלבים טבעיים: \begin_inset Formula 
\[
G\longrightarrow G/\ker f\ \cong\ \operatorname{Im}f\hookrightarrow H.
\]

\end_inset
 תחילה מזהים את האיברים שאין ביניהם הבדל מבחינת \begin_inset Formula $f$
\end_inset
, ואז משכנים את התוצאה ביעד.
\end_layout

\begin_layout Examples

\end_layout

\begin_deeper
\begin_layout Enumerate
עבור \begin_inset Formula $\det:GL_n(F)\to F^\times$
\end_inset
, הגרעין הוא \begin_inset Formula $SL_n(F)$
\end_inset
 וההעתקה על. לכן \begin_inset Formula $GL_n(F)/SL_n(F)\cong F^\times$
\end_inset
.
\end_layout

\begin_layout Enumerate
ההומומורפיזם \begin_inset Formula $\mathbb Z\to\mathbb Z/n\mathbb Z$
\end_inset
 נתון על־ידי \begin_inset Formula $k\mapsto\bar k$
\end_inset
. גרעינו \begin_inset Formula $n\mathbb Z$
\end_inset
, ולכן משפט האיזומורפיזם משחזר את המנה \begin_inset Formula $\mathbb Z/n\mathbb Z$
\end_inset
.
\end_layout

\begin_layout Enumerate
ההטלה \begin_inset Formula $G\times H\to H$
\end_inset
, \begin_inset Formula $(g,h)\mapsto h$
\end_inset
, היא על וגרעינה \begin_inset Formula $G\times\{e\}$
\end_inset
. לכן \begin_inset Formula $(G\times H)/(G\times\{e\})\cong H$
\end_inset
.
\end_layout

\end_deeper
\begin_layout Theorem
\begin_inset Argument 1
status open

\begin_layout Plain Layout
העברה דרך מנה
\end_layout

\end_inset
יהי \begin_inset Formula $N\trianglelefteq G$
\end_inset
 ויהי \begin_inset Formula $f:G\to H$
\end_inset
 הומומורפיזם. אם \begin_inset Formula $N\subseteq\ker f$
\end_inset
, אז קיים הומומורפיזם יחיד \begin_inset Formula $\bar f:G/N\to H$
\end_inset
 כך ש־ \begin_inset Formula 
\[
f=\bar f\circ\pi,
\]

\end_inset
 כאשר \begin_inset Formula $\pi:G\to G/N$
\end_inset
 היא מפת המנה.
\end_layout

\begin_layout Proof
אין לנו בחירה: אם \begin_inset Formula $f=\bar f\circ\pi$
\end_inset
, מוכרחים להגדיר \begin_inset Formula $\bar f(gN)=f(g)$
\end_inset
. התנאי \begin_inset Formula $N\subseteq\ker f$
\end_inset
 מבטיח שהגדרה זו אינה תלויה בנציג: אם \begin_inset Formula $gN=hN$
\end_inset
, אז \begin_inset Formula $h^{-1}g\in N\subseteq\ker f$
\end_inset
, ולכן \begin_inset Formula $f(g)=f(h)$
\end_inset
. קל לבדוק שהמפה הומומורפיזם. היחידות נובעת מכך ש־\begin_inset Formula $\pi$
\end_inset
 על.
\end_layout

\begin_layout Section
סימן של תמורה והחבורה המתחלפת
\end_layout

\begin_layout Standard
כדוגמה חשובה להומומורפיזם שאינו מובן מאליו, נבנה מפה מ־\begin_inset Formula $S_n$
\end_inset
 לחבורה \begin_inset Formula $\{\pm1\}$
\end_inset
.
\end_layout

\begin_layout Definition
ל־\begin_inset Formula $\pi\in S_n$
\end_inset
, זוג \begin_inset Formula $(i,j)$
\end_inset
 עם \begin_inset Formula $i<j$
\end_inset
 נקרא \emph on
היפוך\emph default
 אם \begin_inset Formula $\pi(i)>\pi(j)$
\end_inset
. סימן התמורה הוא \begin_inset Formula 
\[
\operatorname{sgn}(\pi)=(-1)^{\#\{\text{היפוכים של }\pi\}}.
\]

\end_inset
 תמורה בעלת סימן \begin_inset Formula $1$
\end_inset
 נקראת זוגית, ותמורה בעלת סימן \begin_inset Formula $-1$
\end_inset
 נקראת אי־זוגית.
\end_layout

\begin_layout Lemma
יהיו \begin_inset Formula $x_1,\ldots,x_n$
\end_inset
 מספרים ממשיים שונים. אז לכל \begin_inset Formula $\pi\in S_n$
\end_inset
, \begin_inset Formula 
\[
\frac{\prod_{i<j}(x_{\pi(i)}-x_{\pi(j)})}{\prod_{i<j}(x_i-x_j)}=\operatorname{sgn}(\pi).
\]

\end_inset

\end_layout

\begin_layout Proof
במונה מופיע עבור כל זוג ערכים \begin_inset Formula $r<s$
\end_inset
 בדיוק אחד מן הגורמים \begin_inset Formula $x_r-x_s$
\end_inset
 או \begin_inset Formula $x_s-x_r$
\end_inset
. כאשר סדרם התהפך ביחס לסדר המקורי מתקבל גורם \begin_inset Formula $-1$
\end_inset
. מספר ההיפוכים הוא בדיוק מספר שינויי הסימן, ולכן היחס הוא \begin_inset Formula $(-1)^m$
\end_inset
 כאשר \begin_inset Formula $m$
\end_inset
 מספר ההיפוכים.
\end_layout

\begin_layout Theorem
המפה \begin_inset Formula 
\[
\operatorname{sgn}:S_n\to\{\pm1\}
\]

\end_inset
 היא הומומורפיזם.
\end_layout

\begin_layout Proof
נשתמש בלמה. נסמן \begin_inset Formula $\Delta(x_1,\ldots,x_n)=\prod_{i<j}(x_i-x_j)$
\end_inset
. אז \begin_inset Formula 
\[
\operatorname{sgn}(\sigma\pi)=\frac{\Delta(x_{\sigma(\pi(1))},\ldots,x_{\sigma(\pi(n))})}{\Delta(x_1,\ldots,x_n)}.
\]

\end_inset
 נכפיל ונחלק הפעם ב־\begin_inset Formula $\Delta(x_{\sigma(1)},\ldots,x_{\sigma(n)})$
\end_inset
. אם נסמן \begin_inset Formula $y_i=x_{\sigma(i)}$
\end_inset
, אז לפי הלמה \begin_inset Formula 
\[
\frac{\Delta(x_{\sigma(\pi(1))},\ldots,x_{\sigma(\pi(n))})}{\Delta(x_{\sigma(1)},\ldots,x_{\sigma(n)})} =\frac{\Delta(y_{\pi(1)},\ldots,y_{\pi(n)})}{\Delta(y_1,\ldots,y_n)} =\operatorname{sgn}(\pi).
\]

\end_inset
 ושוב לפי הלמה, \begin_inset Formula 
\[
\frac{\Delta(x_{\sigma(1)},\ldots,x_{\sigma(n)})}{\Delta(x_1,\ldots,x_n)}=\operatorname{sgn}(\sigma).
\]

\end_inset
 מכפלת שני השוויונות נותנת \begin_inset Formula 
\[
\operatorname{sgn}(\sigma\pi)=\operatorname{sgn}(\sigma)\operatorname{sgn}(\pi),
\]

\end_inset
 כנדרש.
\end_layout

\begin_layout Definition
הגרעין של \begin_inset Formula $\operatorname{sgn}$
\end_inset
 נקרא \emph on
החבורה המתחלפת\emph default
 ומסומן \begin_inset Formula 
\[
A_n=\{\pi\in S_n:\operatorname{sgn}(\pi)=1\}.
\]

\end_inset

\end_layout

\begin_layout Standard
מאחר שזהו גרעין, \begin_inset Formula $A_n\trianglelefteq S_n$
\end_inset
. עבור \begin_inset Formula $n\ge2$
\end_inset
 הסימן על, ולכן ממשפט האיזומורפיזם הראשון \begin_inset Formula 
\[
S_n/A_n\cong C_2,
\]

\end_inset
 ובפרט \begin_inset Formula $[S_n:A_n]=2$
\end_inset
 ו־\begin_inset Formula $|A_n|=n!/2$
\end_inset
.
\end_layout

\begin_layout Standard
כל טרנספוזיציה היא אי־זוגית. מכיוון שהסימן הומומורפיזם, אם \begin_inset Formula $\pi$
\end_inset
 נכתבת כמכפלה של \begin_inset Formula $k$
\end_inset
 טרנספוזיציות, אז \begin_inset Formula $\operatorname{sgn}(\pi)=(-1)^k$
\end_inset
. מכאן זוגיותו של מספר הטרנספוזיציות בכל פירוק של תמורה נקבעת באופן יחיד, אף שהפירוק עצמו רחוק מלהיות יחיד.
\end_layout

