\begin_inset Formula $2\mathbb Z$
\end_inset
 עם החיבור והכפל הרגילים.
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\mathbb Q$
\end_inset
 עם החיבור והכפל הרגילים.
\end_layout

\end_deeper
