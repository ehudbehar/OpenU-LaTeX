\begin_layout Subsection
תת־חבורות של \begin_inset Formula $\mathbb Z$
\end_inset
 ותזכורת מתורת המספרים
\end_layout

\begin_layout Standard
הדוגמה \begin_inset Formula $m\mathbb Z\le\mathbb Z$
\end_inset
 אינה רק מקור לדוגמאות. למעשה, אין ל־\begin_inset Formula $(\mathbb Z,+)$
\end_inset
 תת־חבורות אחרות. עובדה פשוטה זו תקשר בין שפה חבורתית לבין אלגוריתם החילוק.
\end_layout

\begin_layout Theorem
כל תת־חבורה \begin_inset Formula $H\le(\mathbb Z,+)$
\end_inset
 היא מן הצורה \begin_inset Formula $m\mathbb Z$
\end_inset
 עבור מספר שלם יחיד \begin_inset Formula $m\ge0$
\end_inset
.
\end_layout

\begin_layout Proof
אם \begin_inset Formula $H=\{0\}$
\end_inset
 ניקח \begin_inset Formula $m=0$
\end_inset
. אחרת, מאחר שאם \begin_inset Formula $h\in H$
\end_inset
 אז גם \begin_inset Formula $-h\in H$
\end_inset
, יש ב־\begin_inset Formula $H$
\end_inset
 מספרים חיוביים. יהי \begin_inset Formula $m$
\end_inset
 החיובי הקטן ביותר ב־\begin_inset Formula $H$
\end_inset
. ברור ש־\begin_inset Formula $m\mathbb Z\subseteq H$
\end_inset
. יהי \begin_inset Formula $b\in H$
\end_inset
. לפי אלגוריתם החילוק קיימים \begin_inset Formula $q,r\in\mathbb Z$
\end_inset
 כך ש־ \begin_inset Formula 
\[
b=qm+r,\qquad 0\le r<m.
\]

\end_inset
 מאחר \begin_inset Formula $b,m\in H$
\end_inset
, גם \begin_inset Formula $r=b-qm\in H$
\end_inset
. ממינימליות \begin_inset Formula $m$
\end_inset
 נובע \begin_inset Formula $r=0$
\end_inset
, ולכן \begin_inset Formula $m\mid b$
\end_inset
. מכאן \begin_inset Formula $b\in m\mathbb Z$
\end_inset
, ולכן \begin_inset Formula $H=m\mathbb Z$
\end_inset
. המספר \begin_inset Formula $m$
\end_inset
 הוא האיבר החיובי הקטן ביותר של \begin_inset Formula $H$
\end_inset
, ולכן הוא יחיד.
\end_layout

\begin_layout Corollary
\begin_inset Argument 1
status open

\begin_layout Plain Layout
זהות בזו
\end_layout

\end_inset
לכל \begin_inset Formula $a,b\in\mathbb Z$
\end_inset
, קיימים \begin_inset Formula $x,y\in\mathbb Z$
\end_inset
 כך ש־ \begin_inset Formula 
\[
ax+by=\gcd(a,b).
\]

\end_inset

\end_layout

\begin_layout Proof
הקבוצה \begin_inset Formula 
\[
H=\{ax+by:x,y\in\mathbb Z\}
\]

\end_inset
 היא תת־חבורה של \begin_inset Formula $\mathbb Z$
\end_inset
, ולכן \begin_inset Formula $H=m\mathbb Z$
\end_inset
 עבור \begin_inset Formula $m\ge0$
\end_inset
. מצד אחד \begin_inset Formula $m\in H$
\end_inset
, ולכן \begin_inset Formula $m=ax+by$
\end_inset
 לצמד שלמים כלשהו \begin_inset Formula $x,y$
\end_inset
. מצד שני \begin_inset Formula $a,b\in H$
\end_inset
, ולכן \begin_inset Formula $m$
\end_inset
 מחלק את שניהם. וכל מחלק משותף של \begin_inset Formula $a,b$
\end_inset
 מחלק כל צירוף \begin_inset Formula $ax+by$
\end_inset
, ובפרט את \begin_inset Formula $m$
\end_inset
. לכן \begin_inset Formula $m=\gcd(a,b)$
\end_inset
.
\end_layout

\begin_layout Standard
הזהות תהיה שימושית שוב ושוב. למשל, אם \begin_inset Formula $\gcd(k,n)=1$
\end_inset
, אז קיימים \begin_inset Formula $u,v$
\end_inset
 כך ש־\begin_inset Formula $uk+vn=1$
\end_inset
; בחבורה שבה \begin_inset Formula $a^n=e$
\end_inset
 נקבל מכאן \begin_inset Formula $a=(a^k)^u$
\end_inset
. זוהי הדרך החבורתית לראות מדוע העלאה בחזקה זרה ל־\begin_inset Formula $n$
\end_inset
 אינה מאבדת מידע בחבורה ציקלית מסדר \begin_inset Formula $n$
\end_inset
.
\end_layout

\begin_layout Section
סדר של איבר וחבורות ציקליות
\end_layout

\begin_layout Definition
\emph on
סדרו\emph default
 של איבר \begin_inset Formula $a\in G$
\end_inset
 הוא גודל תת־החבורה \begin_inset Formula $\langle a\rangle$
\end_inset
. נסמן אותו \begin_inset Formula $\operatorname{ord}(a)$
\end_inset
. אם \begin_inset Formula $\langle a\rangle$
\end_inset
 אינסופית, נאמר שסדרו של \begin_inset Formula $a$
\end_inset
 אינסופי.
\end_layout

\begin_layout Standard
אם \begin_inset Formula $\operatorname{ord}(a)=n<\infty$
\end_inset
, אז \begin_inset Formula 
\[
e,a,a^2,\ldots,a^{n-1}
\]

\end_inset
 הם איברים שונים, \begin_inset Formula $a^n=e$
\end_inset
, וכל חזקה של \begin_inset Formula $a$
\end_inset
 שווה לאחד מהם. למעשה, \begin_inset Formula $n$
\end_inset
 הוא המספר החיובי הקטן ביותר שעבורו \begin_inset Formula $a^n=e$
\end_inset
.
\end_layout

\begin_layout Theorem
אם \begin_inset Formula $\operatorname{ord}(a)=n<\infty$
\end_inset
, אז לכל \begin_inset Formula $r,s\in\mathbb Z$
\end_inset
, \begin_inset Formula 
\[
a^r=a^s\Longleftrightarrow n\mid(r-s).
\]

\end_inset
 בפרט, \begin_inset Formula 
\[
a^m=e\Longleftrightarrow n\mid m.
\]

\end_inset

\end_layout

\begin_layout Proof
השוויון \begin_inset Formula $a^r=a^s$
\end_inset
 שקול לאחר כפל ב־\begin_inset Formula $a^{-s}$
\end_inset
 לשוויון \begin_inset Formula $a^{r-s}=e$
\end_inset
. נכתוב לפי אלגוריתם החילוק \begin_inset Formula $r-s=qn+t$
\end_inset
 עם \begin_inset Formula $0\le t<n$
\end_inset
. אז \begin_inset Formula $a^{r-s}=(a^n)^q a^t=a^t$
\end_inset
. לפי מינימליות \begin_inset Formula $n$
\end_inset
, מתקיים \begin_inset Formula $a^t=e$
\end_inset
 רק אם \begin_inset Formula $t=0$
\end_inset
, כלומר \begin_inset Formula $n\mid(r-s)$
\end_inset
. הכיוון ההפוך מיידי מן \begin_inset Formula $a^n=e$
\end_inset
.
\end_layout

\begin_layout Claim
\begin_inset Argument 1
status open

\begin_layout Plain Layout
תוצאה מקדימה לחבורה אבלית סופית
\end_layout

\end_inset
אם \begin_inset Formula $G$
\end_inset
 חבורה אבלית סופית ו־\begin_inset Formula $|G|=N$
\end_inset
, אז לכל \begin_inset Formula $a\in G$
\end_inset
 מתקיים \begin_inset Formula 
\[
a^N=e.
\]

\end_inset
 ולכן \begin_inset Formula $\operatorname{ord}(a)$
\end_inset
 מחלק את \begin_inset Formula $N$
\end_inset
.
\end_layout

\begin_layout Proof
נכתוב \begin_inset Formula $G=\{g_1,\ldots,g_N\}$
\end_inset
. הכפל משמאל ב־\begin_inset Formula $a$
\end_inset
 הוא תמורה של \begin_inset Formula $G$
\end_inset
, ולכן הרשימה \begin_inset Formula 
\[
ag_1,\ldots,ag_N
\]

\end_inset
 מכילה בדיוק את אותם איברים, רק בסדר אחר. מאחר \begin_inset Formula $G$
\end_inset
 אבלית, אפשר לכפול את כל האיברים בלי לחשוש מסדר הגורמים ולקבל \begin_inset Formula 
\[
g_1\cdots g_N=(ag_1)\cdots(ag_N)=a^N g_1\cdots g_N.
\]

\end_inset
 לאחר צמצום מתקבל \begin_inset Formula $a^N=e$
\end_inset
. אם \begin_inset Formula $n=\operatorname{ord}(a)$
\end_inset
, התוצאה הקודמת אומרת ש־\begin_inset Formula $a^N=e$
\end_inset
 אם ורק אם \begin_inset Formula $n\mid N$
\end_inset
.
\end_layout

\begin_layout Standard
זוהי גרסה ראשונה של תופעה כללית הרבה יותר. ביחידה הבאה נוכיח את משפט לגרנז', שמסיר לחלוטין את הנחת החילופיות ומראה שסדרו של כל איבר בחבורה סופית מחלק את סדר החבורה.
\end_layout

\begin_layout Definition
חבורה \begin_inset Formula $G$
\end_inset
 נקראת \emph on
ציקלית\emph default
 אם קיים \begin_inset Formula $a\in G$
\end_inset
 כך ש־\begin_inset Formula $G=\langle a\rangle$
\end_inset
. האיבר \begin_inset Formula $a$
\end_inset
 נקרא \emph on
יוצר\emph default
 של \begin_inset Formula $G$
\end_inset
.
\end_layout

\begin_layout Standard
כל חבורה ציקלית היא אבלית, משום שכל שני איברים הם חזקות של אותו איבר: \begin_inset Formula $a^ra^s=a^{r+s}=a^{s+r}=a^sa^r$
\end_inset
.
\end_layout

\begin_layout Standard
הדוגמאות הבסיסיות הן \begin_inset Formula $(\mathbb Z,+)$
\end_inset
 והחבורות הסופיות \begin_inset Formula $\mathbb Z/n\mathbb Z$
\end_inset
 של מחלקות שארית מודולו \begin_inset Formula $n$
\end_inset
. בסימון חיבורי, \begin_inset Formula $\mathbb Z/n\mathbb Z$
\end_inset
 נוצרת על־ידי המחלקה \begin_inset Formula $\overline1$
\end_inset
.
\end_layout

\begin_layout Theorem
\begin_inset Argument 1
status open

\begin_layout Plain Layout
מיון החבורות הציקליות
\end_layout

\end_inset
כל חבורה ציקלית אינסופית איזומורפית ל־\begin_inset Formula $\mathbb Z$
\end_inset
. כל חבורה ציקלית סופית מסדר \begin_inset Formula $n$
\end_inset
 איזומורפית ל־\begin_inset Formula $\mathbb Z/n\mathbb Z$
\end_inset
.
\end_layout

\begin_layout Proof
יהי \begin_inset Formula $G=\langle a\rangle$
\end_inset
. נגדיר \begin_inset Formula $f:\mathbb Z\to G$
\end_inset
 על־ידי \begin_inset Formula $f(m)=a^m$
\end_inset
. זוהי העתקה על ושומרת פעולה. אם סדר \begin_inset Formula $a$
\end_inset
 אינסופי, אז \begin_inset Formula $a^m=a^r$
\end_inset
 גורר \begin_inset Formula $m=r$
\end_inset
, ולכן \begin_inset Formula $f$
\end_inset
 חד־חד־ערכית. אם סדר \begin_inset Formula $a$
\end_inset
 הוא \begin_inset Formula $n$
\end_inset
, אז \begin_inset Formula $a^m=a^r$
\end_inset
 אם ורק אם \begin_inset Formula $m\equiv r\pmod n$
\end_inset
; לכן \begin_inset Formula $f$
\end_inset
 תלויה רק במחלקת השארית של \begin_inset Formula $m$
\end_inset
 ומשרה איזומורפיזם \begin_inset Formula $\mathbb Z/n\mathbb Z\to G$
\end_inset
.
\end_layout

\begin_layout Claim
אם \begin_inset Formula $\operatorname{ord}(a)=n<\infty$
\end_inset
, אז \begin_inset Formula 
\[
\operatorname{ord}(a^k)=\frac{n}{\gcd(n,k)}.
\]

\end_inset

\end_layout

\begin_layout Proof
סדר \begin_inset Formula $a^k$
\end_inset
 הוא המספר החיובי הקטן ביותר \begin_inset Formula $m$
\end_inset
 שעבורו \begin_inset Formula $a^{km}=e$
\end_inset
, כלומר \begin_inset Formula $n\mid km$
\end_inset
. אם \begin_inset Formula $d=\gcd(n,k)$
\end_inset
 ונכתוב \begin_inset Formula $n=dn_0$
\end_inset
, \begin_inset Formula $k=dk_0$
\end_inset
 עם \begin_inset Formula $\gcd(n_0,k_0)=1$
\end_inset
, התנאי שקול ל־\begin_inset Formula $n_0\mid m$
\end_inset
. המספר החיובי הקטן ביותר הוא אפוא \begin_inset Formula $n_0=n/d$
\end_inset
.
\end_layout

\begin_layout Corollary
בחבורה ציקלית מסדר \begin_inset Formula $n$
\end_inset
, האיבר \begin_inset Formula $a^k$
\end_inset
 הוא יוצר אם ורק אם \begin_inset Formula $\gcd(k,n)=1$
\end_inset
. בפרט, מספר היוצרים הוא \begin_inset Formula $\varphi(n)$
\end_inset
, פונקציית אוילר.
\end_layout

