f(x)=a_0+a_1x+\cdots+a_nx^n,\qquad a_i\in F,
\]

\end_inset
 והחיבור והכפל מוגדרים על־ידי חיבור מקדמים ופתיחת סוגריים לפי חוק הפילוג. למשל, המקדם של \begin_inset Formula $x^k$
\end_inset
 במכפלה \begin_inset Formula 
\[
\left(\sum_i a_ix^i\right)\left(\sum_j b_jx^j\right)
\]

\end_inset
 הוא \begin_inset Formula $\sum_{i+j=k}a_ib_j$
\end_inset
. לעומת זאת, חוג המטריצות \begin_inset Formula $M_n(F)$
\end_inset
 אינו חילופי כאשר \begin_inset Formula $n\ge2$
\end_inset
: כבר ב־\begin_inset Formula $M_2(F)$
\end_inset
 אפשר למצוא מטריצות \begin_inset Formula $A,B$
\end_inset
 שעבורן \begin_inset Formula $AB\ne BA$
\end_inset
.
\end_layout

\begin_layout Example
מעל שדה סופי חשוב להבחין בין פולינום לבין הפונקציה שהוא מגדיר. ב־\begin_inset Formula $\mathbb F_2[x]$
\end_inset
 הפולינום \begin_inset Formula $x^2+x$
\end_inset
 אינו פולינום האפס, אך בהצבת שני איברי השדה מתקבל \begin_inset Formula 
\[
0^2+0=0,\qquad 1^2+1=0,
\]

\end_inset
 ולכן הפונקציה \begin_inset Formula $\mathbb F_2\to\mathbb F_2$
\end_inset
 שהוא מגדיר היא פונקציית האפס. הדוגמה ממחישה שמבנה אלגברי הוא לא רק אוסף הערכים שאנו רגילים לחשב, אלא גם הפעולות והאופן שבו האיברים מיוצגים.
\end_layout

\begin_layout Question
קבעו לגבי כל אחת מן המערכות הבאות אם היא שדה, חוג שאינו שדה, או שאינה חוג לפי המוסכמה שלנו. נמקו לפי האקסיומה שנכשלת או מתקיימת.
\end_layout

