\end_layout

\begin_layout Hint
חשבו מהו הסדר המרבי האפשרי של איבר \begin_inset Formula $(a,b)$
\end_inset
.
\end_layout

\begin_layout Solution
החבורה ציקלית אם ורק אם \begin_inset Formula $\gcd(m,n)=1$
\end_inset
. אם הסדרים זרים, זוג של יוצרים הוא מסדר \begin_inset Formula $\operatorname{lcm}(m,n)=mn$
\end_inset
, ולכן יוצר את כל המכפלה. אם \begin_inset Formula $d=\gcd(m,n)>1$
\end_inset
, אז סדר כל איבר מחלק \begin_inset Formula $\operatorname{lcm}(m,n)=mn/d<mn=|C_m\times C_n|$
\end_inset
, ולכן אין איבר שיכול ליצור את החבורה כולה.
\end_layout

