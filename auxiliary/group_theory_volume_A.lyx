\end_layout

\begin_deeper
\begin_layout Enumerate
\begin_inset Formula $\mathbb Z$
\end_inset
 הוא חוג חילופי אך אינו שדה: למשל, \begin_inset Formula $2\ne0$
\end_inset
 ואין לו הופכי כפלי ב־\begin_inset Formula $\mathbb Z$
\end_inset
.
\end_layout

\begin_layout Enumerate
\begin_inset Formula $M_2(\mathbb R)$
\end_inset
 הוא חוג עם יחידה \begin_inset Formula $I$
\end_inset
, אבל אינו שדה. ראשית, הכפל אינו חילופי. נוסף לכך, יש מטריצות לא־אפס שאינן הפיכות, למשל \begin_inset Formula $\begin{pmatrix}1&0\\0&0\end{pmatrix}$
\end_inset
.
\end_layout

\begin_layout Enumerate
\begin_inset Formula $2\mathbb Z$
\end_inset
 סגורה לחיבור ולכפל ויש בה \begin_inset Formula $0$
\end_inset
, אך אין בה את איבר היחידה הכפלי \begin_inset Formula $1$
\end_inset
. לפי המוסכמה שלנו היא אינה חוג. אילו היינו משתמשים בהגדרה שאינה דורשת יחידה, היא היתה דוגמה לחוג ללא יחידה.
\end_layout

\begin_layout Enumerate
\begin_inset Formula $\mathbb Q$
\end_inset
 הוא שדה: כל רציונלי לא־אפס \begin_inset Formula $a/b$
\end_inset
 הוא בעל הופכי \begin_inset Formula $b/a$
\end_inset
, ושאר האקסיומות מוכרות מן החשבון הרגיל.
\end_layout

\end_deeper
\begin_layout Standard
מנקודת המבט של תורת החבורות חשוב כעת לבודד תופעה משותפת המסתתרת בתוך שדה. אם מתבוננים רק בחיבור, מקבלים מערכת שבה יש קיבוציות, יחידה והופכי; ואם מוחקים את \begin_inset Formula $0$
\end_inset
 ומתבוננים רק בכפל, מתקבל שוב אותו סוג של מבנה. איננו זקוקים לשתי פעולות כדי לתאר את המבנה המשותף. די בפעולה אחת. זהו מושג החבורה.
\end_layout

\begin_layout Section
חבורות: ההגדרה והדוגמאות הראשונות
\end_layout

\begin_layout Definition
\emph on
חבורה\emph default
 היא קבוצה \begin_inset Formula $G$
\end_inset
 עם פעולה דו־מקומית, שאותה נסמן בדרך כלל בכפל, המקיימת שלוש אקסיומות:
\end_layout

\begin_deeper
\begin_layout Enumerate
קיבוציות: לכל \begin_inset Formula $a,b,c\in G$
\end_inset
, מתקיים \begin_inset Formula $(ab)c=a(bc)$
\end_inset
.
\end_layout

\begin_layout Enumerate
איבר יחידה: קיים \begin_inset Formula $e\in G$
\end_inset
 כך שלכל \begin_inset Formula $g\in G$
\end_inset
, מתקיים \begin_inset Formula $eg=ge=g$
\end_inset
.
\end_layout

\begin_layout Enumerate
הופכיים: לכל \begin_inset Formula $g\in G$
\end_inset
 קיים איבר \begin_inset Formula $g^{-1}\in G$
\end_inset
 כך ש־\begin_inset Formula $gg^{-1}=g^{-1}g=e$
\end_inset
.
\end_layout

\end_deeper
\begin_layout Standard
נשים לב למה שאינו נדרש: אין דרישה שהפעולה תהיה חילופית. חבורה שבה מתקיים \begin_inset Formula $ab=ba$
\end_inset
 לכל \begin_inset Formula $a,b$
\end_inset
 נקראת \emph on
חבורה אבלית\emph default
 או \emph on
חבורה חילופית\emph default
. בחבורה אבלית נוח לעיתים לעבור לסימון חיבורי: הפעולה מסומנת \begin_inset Formula $+$
\end_inset
, איבר היחידה מסומן \begin_inset Formula $0$
\end_inset
, וההופכי של \begin_inset Formula $a$
\end_inset
 מסומן \begin_inset Formula $-a$
\end_inset
.
\end_layout

\begin_layout Examples

\end_layout

\begin_deeper
\begin_layout Enumerate
\begin_inset Formula $(\mathbb Z,+)$
\end_inset
 היא חבורה אבלית. איבר היחידה הוא \begin_inset Formula $0$
\end_inset
 וההופכי של \begin_inset Formula $n$
\end_inset
 הוא \begin_inset Formula $-n$
\end_inset
.
\end_layout

\begin_layout Enumerate
אם \begin_inset Formula $F$
\end_inset
 שדה, אז \begin_inset Formula $(F,+)$
\end_inset
 היא חבורה אבלית, וגם \begin_inset Formula $F^\times=F\setminus\{0\}$
\end_inset
 היא חבורה אבלית ביחס לכפל.
\end_layout

\begin_layout Enumerate
הקבוצה \begin_inset Formula $\{e\}$
\end_inset
 היא חבורה. היא נקראת \emph on
החבורה הטריוויאלית\emph default
.
\end_layout

\begin_layout Enumerate
אם \begin_inset Formula $F$
\end_inset
 שדה, אז \begin_inset Formula $GL_n(F)=\{A\in M_n(F):\det A\ne0\}$
\end_inset
 היא חבורה תחת כפל מטריצות. עבור \begin_inset Formula $n\ge2$
\end_inset
 היא בדרך כלל אינה אבלית.
\end_layout

\begin_layout Enumerate
האיזומטריות של המישור יוצרות חבורה תחת הרכבה. האיזומטריות השומרות צורה נתונה יוצרות את \emph on
חבורת הסימטריות\emph default
 שלה.
\end_layout

\end_deeper
\begin_layout Example
יש, עד כדי איזומורפיזם, חבורה יחידה בת שני איברים. אם \begin_inset Formula $G=\{e,a\}$
\end_inset
, אז \begin_inset Formula $a^2$
\end_inset
 מוכרח להיות \begin_inset Formula $e$
\end_inset
 או \begin_inset Formula $a$
\end_inset
. האפשרות \begin_inset Formula $a^2=a$
\end_inset
 גוררת בצמצום \begin_inset Formula $a=e$
\end_inset
, בסתירה לכך שיש שני איברים; לכן \begin_inset Formula $a^2=e$
\end_inset
. טבלת הכפל נקבעת כולה: \begin_inset Formula 
\[
\begin{array}{c|cc} \cdot&e&a\\ \hline e&e&a\\ a&a&e \end{array}
\]

\end_inset
 חבורה זו מסומנת \begin_inset Formula $C_2$
\end_inset
.
\end_layout

\begin_layout Subsection
דוגמאות נוספות ואי־דוגמאות
\end_layout

\begin_layout Standard
הדרך הטובה ביותר להתרגל להגדרת החבורה היא לבדוק אותה על מערכות מוכרות — ובמיוחד להבין היכן היא נכשלת.
\end_layout

\begin_layout Standard
אם \begin_inset Formula $n\ge2$
\end_inset
, נסמן ב־ \begin_inset Formula 
\[
U(n)=\{\bar a\in\mathbb Z/n\mathbb Z:\gcd(a,n)=1\}
\]

\end_inset
 את מחלקות השארית ההפיכות מודולו \begin_inset Formula $n$
\end_inset
. ביחס לכפל מודולו \begin_inset Formula $n$
\end_inset
 זוהי חבורה. למשל \begin_inset Formula 
\[
U(8)=\{\bar1,\bar3,\bar5,\bar7\}.
\]

\end_inset
 לכל אחד מארבעת האיברים ריבוע \begin_inset Formula $\bar1$
\end_inset
, ולכן \begin_inset Formula $U(8)\cong C_2\times C_2$
\end_inset
.
\end_layout

\begin_layout Standard
לעומת זאת, קבוצת השלמים הלא־אפסיים אינה חבורה ביחס לכפל: אמנם הכפל קיבוצי ויש יחידה \begin_inset Formula $1$
\end_inset
, אך ל־\begin_inset Formula $2$
\end_inset
 אין הופכי שלם. גם קבוצת המטריצות \begin_inset Formula $M_n(F)$
\end_inset
 אינה חבורה ביחס לכפל, משום שמטריצות סינגולריות אינן הפיכות. המעבר אל \begin_inset Formula $GL_n(F)$
\end_inset
 הוא בדיוק המעבר לתת־הקבוצה שבה בעיית ההופכיים נפתרת.
\end_layout

\begin_layout Standard
עוד דוגמה מועילה היא חבורת הסימטריות של משולש שווה־צלעות. יש בה שלושה סיבובים ושלושה שיקופים, ולכן שישה איברים. אם נסמן סיבוב של \begin_inset Formula $120^\circ$
\end_inset
 ב־\begin_inset Formula $r$
\end_inset
 ושיקוף ב־\begin_inset Formula $s$
\end_inset
, מתקיימים \begin_inset Formula 
\[
r^3=e,\qquad s^2=e,\qquad srs=r^{-1}.
\]

\end_inset
 זוהי החבורה הדיהדרלית \begin_inset Formula $D_3$
\end_inset
, והיא איזומורפית ל־\begin_inset Formula $S_3$
\end_inset
. בהמשך נראה שהיחסים האלה מאפיינים את החבורה כולה.
\end_layout

\begin_layout Question
חשבו את החבורות \begin_inset Formula $U(5)$
\end_inset
, \begin_inset Formula $U(8)$
\end_inset
 ו־\begin_inset Formula $U(10)$
\end_inset
.
\end_layout

\begin_deeper
\begin_layout Enumerate
מצאו את סדר כל איבר.
\end_layout

\begin_layout Enumerate
קבעו אילו מן החבורות ציקליות.
\end_layout

\begin_layout Enumerate
מצאו איזומורפיזם מפורש כאשר אתם מזהים חבורה ציקלית מוכרת.
\end_layout

\end_deeper
\begin_layout Solution

\end_layout

\begin_deeper
\begin_layout Enumerate
\begin_inset Formula $U(5)=\{\bar1,\bar2,\bar3,\bar4\}$
\end_inset
. מתקיים \begin_inset Formula $\bar2^2=\bar4$
\end_inset
, \begin_inset Formula $\bar2^3=\bar3$
\end_inset
, \begin_inset Formula $\bar2^4=\bar1$
\end_inset
, ולכן \begin_inset Formula $\bar2$
\end_inset
 מסדר \begin_inset Formula $4$
\end_inset
 ו־\begin_inset Formula $U(5)=\langle\bar2\rangle\cong C_4$
\end_inset
.
\end_layout

\begin_layout Enumerate
\begin_inset Formula $U(8)=\{\bar1,\bar3,\bar5,\bar7\}$
\end_inset
. לכל איבר לא־יחידה ריבוע \begin_inset Formula $\bar1$
\end_inset
: \begin_inset Formula $3^2\equiv5^2\equiv7^2\equiv1\pmod8$
\end_inset
. לכן אין איבר מסדר \begin_inset Formula $4$
\end_inset
, והחבורה אינה ציקלית; היא איזומורפית ל־\begin_inset Formula $C_2\times C_2$
\end_inset
.
\end_layout

\begin_layout Enumerate
\begin_inset Formula $U(10)=\{\bar1,\bar3,\bar7,\bar9\}$
\end_inset
. החזקות של \begin_inset Formula $\bar3$
\end_inset
 הן \begin_inset Formula $\bar3,\bar9,\bar7,\bar1$
\end_inset
, ולכן \begin_inset Formula $\bar3$
\end_inset
 מסדר \begin_inset Formula $4$
\end_inset
 ו־\begin_inset Formula $U(10)\cong C_4$
\end_inset
.
\end_layout

\end_deeper
\begin_layout Standard
דוגמת הסימטריות חשובה במיוחד. נניח שאנו מסובבים ריבוע ברבע סיבוב, ולאחר מכן משקפים אותו ביחס לציר. שתי הפעולות בזו אחר זו הן שוב סימטריה של הריבוע. הפעולה הטבעית בחבורה אינה "חיבור" של סימטריות אלא \emph on
הרכבה\emph default
: מבצעים תחילה אחת ואחר כך את השנייה. סדר הביצוע עשוי לשנות את התוצאה, ולכן חבורות סימטריה הן מקור טבעי לחבורות לא־אבליות.
\end_layout

\begin_layout Subsection
חבורת התמורות
\end_layout

\begin_layout Standard
תהי \begin_inset Formula $X$
\end_inset
 קבוצה. תמורה של \begin_inset Formula $X$
\end_inset
 היא פונקציה חד־חד־ערכית ועל מ־\begin_inset Formula $X$
\end_inset
 אל עצמה. אוסף כל התמורות של \begin_inset Formula $X$
\end_inset
, עם פעולת ההרכבה, הוא חבורה; נסמן אותו \begin_inset Formula $S_X$
\end_inset
. כאשר \begin_inset Formula $X=\{1,\ldots,n\}$
\end_inset
, נסמן את החבורה \begin_inset Formula $S_n$
\end_inset
.
\end_layout

\begin_layout Standard
נשתמש במוסכמה \begin_inset Formula 
\[
(\sigma\tau)(i)=\sigma(\tau(i)),
\]

\end_inset
 כלומר התמורה הימנית פועלת ראשונה.
\end_layout

\begin_layout Example
ב־\begin_inset Formula $S_3$
\end_inset
 ניקח \begin_inset Formula $\sigma=(12)$
\end_inset
 ו־\begin_inset Formula $\tau=(23)$
\end_inset
. אז \begin_inset Formula 
\[
\sigma\tau=(123),\qquad \tau\sigma=(132).
\]

\end_inset
 לכן \begin_inset Formula $\sigma\tau\ne\tau\sigma$
\end_inset
, ומכאן \begin_inset Formula $S_3$
\end_inset
 אינה אבלית. אותו רעיון מראה ש־\begin_inset Formula $S_n$
\end_inset
 אינה אבלית לכל \begin_inset Formula $n\ge3$
\end_inset
.
\end_layout

\begin_layout Standard
נשתמש בהרחבה בכתיב מחזורים. המחזור \begin_inset Formula $(a_1a_2\ldots a_k)$
\end_inset
 שולח את \begin_inset Formula $a_1$
\end_inset
 אל \begin_inset Formula $a_2$
\end_inset
, את \begin_inset Formula $a_2$
\end_inset
 אל \begin_inset Formula $a_3$
\end_inset
, וכן הלאה, ואת \begin_inset Formula $a_k$
\end_inset
 אל \begin_inset Formula $a_1$
\end_inset
, ומשאיר את שאר הנקודות במקומן. מחזורים זרים, כלומר מחזורים שאין להם נקודות משותפות, מתחלפים זה עם זה.
\end_layout

