\begin_layout Solution
לכל \begin_inset Formula $a,b\in G$
\end_inset
 מתקיים \begin_inset Formula $(ab)^2=e$
\end_inset
, ולכן \begin_inset Formula $abab=e$
\end_inset
. מצד שני \begin_inset Formula $a^2=b^2=e$
\end_inset
, ולכן \begin_inset Formula $a^{-1}=a$
\end_inset
 ו־\begin_inset Formula $b^{-1}=b$
\end_inset
. מן \begin_inset Formula $(ab)^{-1}=b^{-1}a^{-1}$
\end_inset
 נקבל \begin_inset Formula $(ab)^{-1}=ba$
\end_inset
, ואילו מן \begin_inset Formula $(ab)^2=e$
\end_inset
 נקבל \begin_inset Formula $(ab)^{-1}=ab$
\end_inset
. לכן \begin_inset Formula $ab=ba$
\end_inset
. מכיוון שהאיברים שרירותיים, \begin_inset Formula $G$
\end_inset
 אבלית.
\end_layout

