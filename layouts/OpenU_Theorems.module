#\DeclareLyXModule{OpenU Theorems}
#\DeclareCategory{OpenUniversity}
#DescriptionBegin
#Defines theorem environments in Hebrew, built on amsthm. To be used with babel. Author: Ehud Behar. Updated 2026-August-11
#DescriptionEnd
#Author: Ehud Behar

Format 66
Requires amsthm
# Define Counters
Counter definition
    Within         chapter
End

Counter question
    Within         chapter
End

Counter example
    Within         chapter
End

AddToPreamble
% Create a new counter for thm-like environments, reset every time a new \chapter{...} is started
\newcounter{definition}[chapter]
% thm number is printed before chapter number:
\renewcommand{\thedefinition}{\thechapter.\arabic{definition}}
% Define style for thms. This style is used for defs, thms, lemmas, corollaries, etc.
\newtheoremstyle{thms}
  {0pt}% space above
  {0pt}% space below
  {}% body font
  {0pt}% indent amount
  {\narkistamfamily\bfseries}% head font
  {}% punctuation after head
  {\newline}% space after head
  {\thmname{#1}\ \thmnumber{#2}\ \thmnote{(#3)}}% head spec
% macros for correct vskips between the hrules and the theorem
\newlength\thmrulesep    \setlength\thmrulesep{12pt}
\newlength\thmruleskip   \setlength\thmruleskip{17pt}  % outside the rules
\def\thmframe@open{%
  \par \addvspace{\thmruleskip}%
  \hrule
  \prevdepth\dimexpr\baselineskip-\thmrulesep\relax
  \@topsep\parskip
  \@beginparpenalty\@M}          % the top rule may not be orphaned
\def\thmframe@close{%
  \par
  \@tempskipa\lastskip \vskip-\@tempskipa
  \@tempdima\prevdepth \ifdim\@tempdima<\z@ \@tempdima\z@ \fi
  \kern\dimexpr\thmrulesep-\@tempdima\relax
  \nobreak                       % nor the bottom rule from the last line
  \hrule
  \addvspace{\thmruleskip}}

% based on TeX.SE/a/122025, fix when enumerate or itemize are first after theorem head
\newif\ifthm@startlist
\let\thm@dth@orig\deferred@thm@head
\def\deferred@thm@head#1{\global\thm@startlisttrue\thm@dth@orig{#1}}
\dth@everypar=\expandafter{\the\dth@everypar \global\thm@startlistfalse}
\let\thm@trivlist@orig\@trivlist
\def\@trivlist{%
  \if@inlabel\ifthm@startlist
    \leavevmode\hbox{}\par\nobreak
    \vskip\glueexpr-\baselineskip-\partopsep+0pt\relax
    \hrule height\z@ \prevdepth\z@
    \global\thm@startlistfalse
  \fi\fi
  \thm@trivlist@orig}
% same idea for amsmath displays: they don't go through \@trivlist
\newcommand*{\thm@flush@head@for@display}{%
  \if@inlabel\ifthm@startlist
    \leavevmode  % fires \everypar: the deferred head is typeset now
    \unskip\unpenalty\unskip\unpenalty % remove \hskip\thm@headsep and \nobreak\hfil\break
    %\abovedisplayskip11pt\relax This line doesn't seem to have effect
  \fi\fi}
\@for\thm@tmp:=equation,equation*,align,align*,alignat,alignat*,%
    flalign,flalign*,gather,gather*,multline,multline*\do{%
  \AddToHook{env/\thm@tmp/before}{\thm@flush@head@for@display}}
EndPreamble

Style Definition
    Category              Reasoning
    Margin                Dynamic
    LatexType             Environment
    LatexName             definition
    ResetArgs             1
    KeepEmpty             1 # allow to leave a paragraph empty
    Argument              1
            LabelString    "Additional Theorem Text"
            Tooltip        "Additional text appended to the theorem header"
            IsTocCaption      1
         Decoration    Minimalistic
        EndArgument
    AddToToc              "משפטים והגדרות"
    IsTocCaption          1
    LabelSep              xx
    TopSep                1
    BottomSep             1
    LabelType             Static
    LabelCounter          definition
    LabelString           "הגדרה \thedefinition"
    LabelFont
      Shape               Up
      Series              Bold
    EndFont
    RefPrefix             def
    Preamble
% Create a new definition environment 
\theoremstyle{thms}% activate style
\newtheorem{definition@thm}[definition]{הגדרה}
\newenvironment{definition}[1][]%
  {\thmframe@open\begin{definition@thm}[#1]}%
  {\end{definition@thm}\thmframe@close}
    EndPreamble
End

Style Theorem
    CopyStyle             Definition
    DependsOn             Definition
    LatexName             theorem
    LabelString           "משפט \thedefinition"
    RefPrefix             thm
    Preamble
\theoremstyle{thms}% activate style
\newtheorem{theorem@thm}[definition]{משפט}
\newenvironment{theorem}[1][]%
  {\thmframe@open\begin{theorem@thm}[#1]}%
  {\end{theorem@thm}\thmframe@close}
    EndPreamble
End

Style Lemma
    CopyStyle             Definition
    DependsOn             Definition
    LatexName             lemma
    LabelString           "למה \thedefinition"
    RefPrefix             lemma
    Preamble
\theoremstyle{thms}% activate style
\newtheorem{lemma@thm}[definition]{למה}
\newenvironment{lemma}[1][]%
  {\thmframe@open\begin{lemma@thm}[#1]}%
  {\end{lemma@thm}\thmframe@close}
    EndPreamble
End

Style Claim
    CopyStyle             Definition
    DependsOn             Definition
    LatexName             claim
    LabelString           "טענה \thedefinition"
    RefPrefix             claim
    Preamble
\theoremstyle{thms}% activate style
\newtheorem{claim@thm}[definition]{טענה}
\newenvironment{claim}[1][]%
  {\thmframe@open\begin{claim@thm}[#1]}%
  {\end{claim@thm}\thmframe@close}
    EndPreamble
End

Style Corollary
    CopyStyle             Definition
    DependsOn             Definition
    LatexName             corollary
    LabelString           "מסקנה \thedefinition"
    RefPrefix             cor
    Preamble
\theoremstyle{thms}% activate style
\newtheorem{corollary@thm}[definition]{מסקנה}
\newenvironment{corollary}[1][]%
  {\thmframe@open\begin{corollary@thm}[#1]}%
  {\end{corollary@thm}\thmframe@close}
    EndPreamble
End

#Style Remark
#    CopyStyle             Definition
#    DependsOn             Definition
#    LatexName             remark
#    LabelString           "הערה \thedefinition"
#    RefPrefix             rmrk
#    Preamble
#\thmblockshared{remark}{definition}{הערה}
#    EndPreamble
#End
