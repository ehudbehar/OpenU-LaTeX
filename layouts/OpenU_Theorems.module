#\DeclareLyXModule{OpenU Theorems}
#\DeclareCategory{OpenUniversity}
#DescriptionBegin
#Defines theorem environments in Hebrew, built on amsthm. To be used with babel. Author: Ehud Behar. Updated 2026-August-5
#DescriptionEnd
#Author: Ehud Behar

Format 66
Requires amsthm
# Define Counters
Counter definition
    Within         chapter
End

Counter question
    Within         chapter
End

Counter example
    Within         chapter
End

AddToPreamble
%%% ==================================================================
%%%  Shared infrastructure for every theorem-like environment.
%%%
%%%  Module AddToPreamble content becomes part of the text class
%%%  preamble, which LyX emits BEFORE the loop over the layouts a given
%%%  document actually uses.  So everything defined here is guaranteed
%%%  to exist by the time any Style preamble below is expanded, no
%%%  matter which subset of the styles the document happens to use.
%%%  (DependsOn would not be enough: LyX resolves it only one level.)
%%% ==================================================================

% ---- counters (reset at every \chapter) ---------------------------
% These live here rather than in the Style preambles because
% \newtheorem{x}[definition]{...} needs c@definition to exist already.
\newcounter{definition}[chapter]
\renewcommand{\thedefinition}{\thechapter.\arabic{definition}}
\newcounter{example}[chapter]
\renewcommand{\theexample}{\thechapter.\arabic{example}}
\newcounter{question}[chapter]
\renewcommand{\thequestion}{\thechapter.\arabic{question}}

% ---- end-of-block symbols -----------------------------------------
% Defined here so that `examples` never depends on `example` having
% been emitted, and `proof` never depends on anything at all.
\def\qedsymbol{\leavevmode\textcolor{DGray}{$\square$}}
\def\exampleqedsymbol{\leavevmode\textcolor{DGray}{$\blacktriangleright$}}

% ---- geometry of the ruled blocks ---------------------------------
% \thmrulesep is measured rule <-> nearest BASELINE (head baseline at
% the top, last body baseline at the bottom), not rule <-> ink.
\newlength\thmrulesep    \setlength\thmrulesep{12pt}
\newlength\thmruleskip   \setlength\thmruleskip{17pt}  % outside the rules
\newlength\thmrulewidth  \setlength\thmrulewidth{0.4pt}

% ---- head styles --------------------------------------------------
% The 8th argument, \newline, is the whole trick: amsthm turns it into
%   \thm@headsep\z@skip \def\thmheadnl{\newline}
% which routes the head through \deferred@thm@head.  The head is then
% boxed into \@labels and released only when the body's first paragraph
% really starts, so we are still in VERTICAL mode when the body is
% scanned -- and a \par in vertical mode is a no-op.  That is what makes
% a blank line between the head and the body harmless, for every
% environment at once.  Nothing below needs to know about it.
\newtheoremstyle{hebnarkis}{0pt}{0pt}{}{0pt}
  {\narkistamfamily\bfseries}{}{\newline}
  {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

\newtheoremstyle{hebnarkismark}{0pt}{0pt}{}{0pt}
  {\narkistamfamily\bfseries}{}{\newline}
  {\textcolor{DGray}{$\blacktriangleleft$}~\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

% Same, but the note is typeset bare rather than parenthesised.  Used by
% hintaux/solutionaux, which are unnumbered and receive the question
% number as their note.
\newtheoremstyle{hebplain}{0pt}{0pt}{}{0pt}
  {\normalfont\bfseries}{}{\newline}
  {\thmname{#1}\thmnumber{ #2}\thmnote{ #3}}

% ---- rule frame ---------------------------------------------------
% Top: an \hrule sets \prevdepth to -1000pt, which suppresses interline
% glue.  Overriding it with \baselineskip-\thmrulesep makes TeX compute
% that glue as \thmrulesep-\ht(head line), so rule -> head baseline comes
% out at exactly \thmrulesep whatever the head's height turns out to be
% -- no measuring, and it self-corrects if the head font changes.
% \@topsep must be \parskip (not 0pt): \deferred@thm@head issues
% \addvspace\@topsep followed by \addvspace{-\parskip}, and those two
% have to cancel or they land between the rule and the head and offset
% the arithmetic above by one \parskip.
% Bottom: the mirror image.  Drop whatever trailing glue the body left
% (a list's \topsep, a display's \belowdisplayskip, \@endparenv's zero)
% with \vskip-\lastskip, then kern by \thmrulesep minus the last line's
% depth, so last baseline -> rule is \thmrulesep regardless of
% descenders.  Same arithmetic as \@MarginAnchor further down, mirrored.
\def\thmframe@open{%
  \par \addvspace{\thmruleskip}%
  \hrule height\thmrulewidth
  \prevdepth\dimexpr\baselineskip-\thmrulesep\relax
  \@topsep\parskip
  \@beginparpenalty\@M}          % the top rule may not be orphaned
\def\thmframe@close{%
  \par
  \@tempskipa\lastskip \vskip-\@tempskipa
  \@tempdima\prevdepth \ifdim\@tempdima<\z@ \@tempdima\z@ \fi
  \kern\dimexpr\thmrulesep-\@tempdima\relax
  \nobreak                       % nor the bottom rule from the last line
  \hrule height\thmrulewidth
  \addvspace{\thmruleskip}}

% ---- factories ----------------------------------------------------
% Nothing below this point sets a font, forces a line break, or touches
% \@topsep: head typesetting lives entirely in the styles above, and
% vertical space around the ruled family entirely in the frame above.
% \refstepcounter is gone too -- amsthm does it -- so \label placed
% immediately after \begin{...} still points at the right number, and
% \qedhere still works.

% ruled family:  \NewThmBlock{<env>}{<counter>}{<head text>}
\newcommand\NewThmBlock[3]{%
  \theoremstyle{hebnarkis}%
  \newtheorem{#1@thm}[#2]{#3}%
  \newenvironment{#1}[1][]%
    {\thmframe@open\begin{#1@thm}[##1]}%
    {\end{#1@thm}\thmframe@close}}

% QED family:  \NewThmQED{<env>}{<counter>}{<head text>}{<symbol macro>}
\newcommand\NewThmQED[4]{%
  \theoremstyle{hebnarkismark}%
  \newtheorem{#1@thm}[#2]{#3}%
  \newenvironment{#1}[1][]%
    {\let\qedsymbol#4\pushQED{\qed}\begin{#1@thm}[##1]}%
    {\popQED\end{#1@thm}}}

% back-matter family:  \NewAuxBlock{<env>}{<head text>}
% signature [<exercise option>]{<question number>}, unchanged, so the
% \write templates in Solution and Hint keep working verbatim.
% The empty-argument test is your own \detokenize idiom from the previous
% code rather than \IfBlankTF: the latter is not in the LaTeX kernel of
% TeX Live 2022 and earlier, so it would silently break on older installs.
\newcommand\NewAuxBlock[2]{%
  \theoremstyle{hebplain}%
  \newtheorem*{#1@thm}{#2}%
  \NewDocumentEnvironment{#1}{O{} m}%
    {\begin{#1@thm}[##2\if\relax\detokenize{##1}\relax\else~(##1)\fi]}%
    {\end{#1@thm}}}

% question family:  \NewQuestionEnv{<env>}{<head text>}{<margin-ref code>}
% Note the end-code order -- margin reference, THEN \label, THEN \end.
% \label deposits a whatsit on the vertical list, after which \lastskip
% reads 0pt and \@MarginAnchor's correction silently does nothing.
\newcommand\NewQuestionEnv[3]{%
  \theoremstyle{hebnarkis}%
  \newtheorem{#1@thm}[question]{#2}%
  \newenvironment{#1}[1][]%
    {\gdef\exerciseopt{##1}\begin{#1@thm}[##1]}%
    {#3\label{ques:\thequestion}\end{#1@thm}}}
EndPreamble

Style Definition
    Category              Reasoning
    Margin                Dynamic
    LatexType             Environment
    LatexName             definition
    ResetArgs             1
    KeepEmpty             1 # allow to leave a paragraph empty
    Argument              1
            LabelString    "Additional Theorem Text"
            Tooltip        "Additional text appended to the theorem header"
            IsTocCaption      1
         Decoration    Minimalistic
        EndArgument
    AddToToc              "משפטים והגדרות"
    IsTocCaption          1
    LabelSep              xx
    TopSep                1
    BottomSep             1
    LabelType             Static
    LabelCounter          definition
    LabelString           "הגדרה \thedefinition"
    LabelFont
      Shape               Up
      Series              Bold
    EndFont
    RefPrefix             def
    Preamble
\NewThmBlock{definition}{definition}{הגדרה}
    EndPreamble
End

Style Theorem
    CopyStyle             Definition
    DependsOn             Definition
    LatexName             theorem
    LabelString           "משפט \thedefinition"
    RefPrefix             thm
    Preamble
\NewThmBlock{theorem}{definition}{משפט}
    EndPreamble
End

Style Lemma
    CopyStyle             Definition
    DependsOn             Definition
    LatexName             lemma
    LabelString           "למה \thedefinition"
    RefPrefix             lemma
    Preamble
\NewThmBlock{lemma}{definition}{למה}
    EndPreamble
End

Style Claim
    CopyStyle             Definition
    DependsOn             Definition
    LatexName             claim
    LabelString           "טענה \thedefinition"
    RefPrefix             claim
    Preamble
\NewThmBlock{claim}{definition}{טענה}
    EndPreamble
End

Style Corollary
    CopyStyle             Definition
    DependsOn             Definition
    LatexName             corollary
    LabelString           "מסקנה \thedefinition"
    RefPrefix             cor
    Preamble
\NewThmBlock{corollary}{definition}{מסקנה}
    EndPreamble
End

#Style Remark
#    CopyStyle             Definition
#    DependsOn             Definition
#    LatexName             remark
#    LabelString           "הערה \thedefinition"
#    RefPrefix             rmrk
#    Preamble
#\NewThmBlock{remark}{definition}{הערה}
#    EndPreamble
#End

Style Proof
    CopyStyle             Definition
    DependsOn             Definition
    LatexName             proof
    LabelString           "הוכחה"
    RefPrefix             prf
    Argument 1
      Mandatory 0
      LabelString    "כותרת חלופית"
      Tooltip        "'כותרת מותאמת אישית במקום 'הוכחה"
      IsTocCaption      1
      Decoration    Conglomerate
      Font
        Series Bold
      EndFont
    EndArgument
    Preamble
% proof is deliberately NOT built by a factory: its optional argument
% replaces the head instead of being appended as a parenthesised note.
% It therefore calls \deferred@thm@head directly -- the very mechanism the
% `\newline' head space reaches for every other environment here, so it
% gains the same immunity to a blank line after \begin{proof}.
% \@topsep / \@topsepadd must be set AFTER \trivlist, which initialises
% them from \topsep / \partopsep; with no \item in play that first pair is
% never read.  \qedsymbol lives in the module's shared preamble.
\renewenvironment{proof}[1][הוכחה]%
  {\par
   \pushQED{\qed}%
   \normalfont
   \trivlist                % only so \endtrivlist below has a partner
   \@topsep 6\p@ \@topsepadd \z@
   \deferred@thm@head{\noindent{\narkistamfamily\bfseries #1}\newline}}%
  {\popQED\endtrivlist\@endpefalse}
    EndPreamble
End

Style Example
    Category              Reasoning
    Margin                Dynamic
    LatexType             Environment
    LatexName             example
    LabelType             Above
    LabelCounter          example
    KeepEmpty            1 # allow to leave a paragraph empty
    ResetArgs             1
    Argument              1
            LabelString    "Additional Theorem Text"
            Tooltip        "Additional text appended to the theorem header"
            IsTocCaption      1
         Decoration    Minimalistic
        EndArgument
    AddToToc              "משפטים והגדרות"
    IsTocCaption          1
    LabelSep              xx
    TopSep                1
    BottomSep             1
    LabelString           "דוגמה \theexample ◀"
    LabelFont
      Shape               Up
      Series              Bold
    EndFont
    RefPrefix             exmpl
    Preamble
\NewThmQED{example}{example}{דוגמה}{\exampleqedsymbol}
    EndPreamble
End


Style Examples
    CopyStyle             Example
    DependsOn             Example
    LatexName             examples
    LabelString           "דוגמאות \theexample ◀"
    RefPrefix             exmpl

    Preamble
\NewThmQED{examples}{example}{דוגמאות}{\exampleqedsymbol}
    EndPreamble
End

AddToPreamble
\newwrite\solutionwrite
\immediate\openout\solutionwrite=solutionlist.tex
\newwrite\hintwrite
\immediate\openout\hintwrite=hintlist.tex
% Close the output and print the stream inside a chapter
\AtEndDocument{%
  \immediate\closeout\hintwrite
  \immediate\closeout\solutionwrite
  \chapter*{רמזים ופתרונות לשאלות בכרך \thepart}
  \section*{רמזים לשאלות ביחידה \thechapter}
  \input hintlist
  \section*{פתרונות לשאלות ביחידה \thechapter}
  \input solutionlist
}

% macro that guarantees that the margin reference is anchored on the baseline of the LAST line of the surrounding environment, no matter how that body ended (hmode or vmode).
% CALLER'S RULE: this must be the LAST thing before the environment ends.
% \lastskip only reports glue when the glue really is the last item, so
% anything that deposits a node after the body -- a \label whatsit above all
% -- makes it read 0pt and the correction below silently does nothing.
% Dedicated registers rather than \@tempskipa / \@tempdima: if the marginpar's
% float penalty fires the output routine, \@addmarginpar runs and clobbers
% \@tempdima before the \kern below reads it back.
\newskip\ma@skip
\newdimen\ma@depth
\newcommand\@MarginAnchor[1]{%
  \ifhmode
    #1%
  \else
    \ma@skip\lastskip
    \ma@depth\prevdepth
    \ifdim\ma@depth<\z@ \ma@depth\z@ \fi % guard against \prevdepth = -1000pt
    \vskip-\ma@skip
    \kern-\ma@depth
    #1%
    \kern\ma@depth
    \vskip\ma@skip
  \fi}

% macro to typeset a single marginpar (used in `question` and `answer` envs)
\protected\def\SingleMarginRef#1{%
  \@MarginAnchor{\marginpar{%
    \setbox\z@\vbox{%
      \hbox{%
        \rlap{\pdfextension literal direct {0.847 0.847 0.847 rg}%
          {\vrule height 5.92mm width\marginparwidth depth 3.5mm}%
          \pdfextension literal direct {0 g}}%
        \hskip4pt #1}%
    }%
    \vskip-\ht\z@\relax
    \box\z@}}%
}

% macro to typeset two marginpars (used in `questionremez` and `hint` envs)
\protected\def\DoubleMarginRefs#1#2{%
  \@MarginAnchor{\marginpar{%
    \setbox\z@\vbox{%
      \hbox{%
        \rlap{\pdfextension literal direct {0.847 0.847 0.847 rg}%
          {\vrule height 3.83mm width\marginparwidth depth 1.76mm}%
          \pdfextension literal direct {0 g}}%
        \hskip4pt #1}%
      \vskip1.55mm
      \hbox{%
        \rlap{\pdfextension literal direct {0.847 0.847 0.847 rg}%
          {\vrule height 3.83mm width\marginparwidth depth 1.76mm}%
          \pdfextension literal direct {0 g}}%
        \hskip4pt #2}%
    }%
    \vskip-\ht\z@\relax
    \box\z@}}%
}
EndPreamble

Style Question
    Category              Reasoning
    Margin                Dynamic
    LatexType             Environment
    LatexName             question
    LabelType             Static
    LabelCounter          question
    RefPrefix             questn
    KeepEmpty            1 # allow to leave a paragraph empty
    ResetArgs             1
    Argument              1
            LabelString    "Additional Theorem Text"
            Tooltip        "Additional text appended to the theorem header"
            IsTocCaption      1
         Decoration    Minimalistic
        EndArgument
    AddToToc              "משפטים והגדרות"
    IsTocCaption          1
    LabelSep              xx
    TopSep                1
    BottomSep             1
    LabelString           "שאלה \thequestion"
    LabelFont
      Shape               Up
      Series              Bold
    EndFont
    Preamble
\NewQuestionEnv{question}{שאלה}
  {\SingleMarginRef{הפתרון בעמוד \pageref{sol:\thequestion}}}
    EndPreamble
End

Style Solution
    CopyStyle             Question
    DependsOn             Question
    LatexName             solution
    LabelCounter          ""
    LabelString           "פתרון \thequestion"
    RefPrefix             solutn
    Preamble
\NewAuxBlock{solutionaux}{תשובה}

\NewDocumentEnvironment{solution}{+b}{%
  \immediate\write\solutionwrite{^^J%
    \detokenize{\begin{solutionaux}}[\exerciseopt]^^J
    \string{\thequestion\string}^^J%
    \noexpand\label{sol:\thequestion}^^J%
    \detokenize{#1}%
    \noexpand\SingleMarginRef{השאלה בעמוד \noexpand\pageref{ques:\thequestion}}^^J%
^^J%
    \detokenize{\end{solutionaux}}%
  }%
}{\immediate\write\solutionwrite{\noexpand\vspace{\parskip}}}
    EndPreamble
End



Style QuestionW/Hint
    CopyStyle             Question
    DependsOn             Question
    LatexName             questionremez
    LabelString           "שאלה (עם רמז) \thequestion"
    RefPrefix             questn
    Preamble
\NewQuestionEnv{questionremez}{שאלה}
  {\DoubleMarginRefs{רמז בעמוד \pageref{hint:\thequestion}}%
                    {התשובה בעמוד \pageref{sol:\thequestion}}}
    EndPreamble
End

Style Hint
    CopyStyle             Question
    DependsOn             Question
    LatexName             hint
    LabelCounter          ""
    LabelString           "רמז \thequestion"
    RefPrefix             hint
    Preamble
\NewAuxBlock{hintaux}{רמז}

\NewDocumentEnvironment{hint}{+b}{%
  \immediate\write\hintwrite{^^J%
    \detokenize{\begin{hintaux}}[\exerciseopt]^^J
    \string{\thequestion\string}^^J%
    \noexpand\label{hint:\thequestion}^^J%
    \detokenize{#1}%
    \noexpand\DoubleMarginRefs{השאלה בעמוד \noexpand\pageref{ques:\thequestion}}{התשובה בעמוד \noexpand\pageref{sol:\thequestion}}^^J%
^^J%
    \detokenize{\end{hintaux}}%
  }%
}{\immediate\write\hintwrite{\noexpand\vspace{\parskip}}}
    EndPreamble
End